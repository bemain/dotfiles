{
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.diagnosticSeverityOverrides": {
        "reportUnusedVariable": "information",
        "reportUnusedImport": "information",
    },
    "editor.fontFamily": "MesloLGS NF",
    "dev.containers.dockerPath": "/app/tools/podman/bin/podman-remote",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.fontFamily": "MesloLGS NF",
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.openRepositoryInParentFolders": "never",
    "gitlens.currentLine.enabled": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "workbench.settings.applyToAllProfiles": [
        "terminal.integrated.defaultProfile.linux",
        "terminal.integrated.fontFamily",
        "git.autofetch",
        "git.confirmSync",
        "git.enableSmartCommit",
        "git.openRepositoryInParentFolders",
        "gitlens.currentLine.enabled",
        "github.copilot.enable"
    ],
    "geminicodeassist.project": "",
    "diffEditor.codeLens": true,
    "editor.renderWhitespace": "none",
    "editor.renderControlCharacters": false,
    "jupyter.interactiveWindow.creationMode": "perFile",
    "plantuml.server": "http://localhost:8080",
    "plantuml.render": "PlantUMLServer",
    "containers.containerClient": "com.microsoft.visualstudio.containers.podman",
    "[dart]": {
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.rulers": [
            80
        ],
        "editor.selectionHighlight": false,
        "editor.tabCompletion": "onlySnippets",
        "editor.wordBasedSuggestions": "off",
    },
    "update.showReleaseNotes": false,
    "github.copilot.nextEditSuggestions.enabled": true,
    "git.blame.editorDecoration.enabled": false,
    "dart.flutterSdkPath": "/usr/local/flutter/bin",
    "http.systemCertificatesNode": true,
    "git.pruneOnFetch": true,
    "terminal.integrated.env.linux": {
        "SSH_AUTH_SOCK": "/var/home/agardh/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock",
    },
    "gitlens.signing.enableKeyGeneration": false,
    "git.enableCommitSigning": false,
    "git.replaceTagsWhenPull": true,
    "geminicodeassist.inlineSuggestions.enableAuto": false,
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
        "*.qrc": "qt-core.qrcEditor"
    },
    "qt-core.additionalQtPaths": [
        {
            "name": "Qt-6.10.3-linux-g++-x86_64_from_PATH",
            "path": "/usr/bin/qmake"
        }
    ],
    "nrf-connect.enableTelemetry": false,
    "nrf-connect.sdkManager.region": "default",
    "claudeCode.preferredLocation": "panel",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "dart.flutterCreatePlatforms": [
        "linux",
        "macos",
        "windows",
        "web"
    ],
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilotcli:",
    "editor.bracketPairColorization.enabled": false,
    "workbench.secondarySideBar.showLabels": false,
}