[credential]
	helper = store

[user]
	name = bemain
	email = bemain.dev@gmail.com
	signingkey = ~/.ssh/id_default.pub

[gpg]
	format = ssh

[init]
	defaultBranch = main

[push]
    default = current
	autoSetupRemote = true

[pull]
    rebase = true

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[color]
    ui = auto

[core]
    excludesFile = $HOME/.config/git/ignore
    sshCommand = ssh -i ~/.ssh/id_default.pub -o IdentitiesOnly=yes

[alias]
	# Undo last commit but keep changes
	undo = reset HEAD~1 --soft
	# Undoes an undo by using the reflog
	redo = !git reset 'HEAD@{1}' --soft
	# Edit the last commit message
	edit = commit --amend --only
	# List aliases
	aliases = config --get-regexp alias
