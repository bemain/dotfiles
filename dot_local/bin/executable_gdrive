#!/usr/bin/env bash

## If you change this script, don't forget to update completions in
## /var/home/agardh/.oh-my-zsh/custom/completions/_gdrive

# --- Configuration ---
CONFIG_DIR="$HOME/.config/gdrive-sync"
CONFIG_FILE="$CONFIG_DIR/config.yml"
REMOTE="gdrive:"

# Rclone comparison flags for reliability
BISYNC_FLAGS="--create-empty-src-dirs --compare size,modtime --modify-window 1s --drive-skip-gdocs"

# Global flags for the current session
SESSION_FLAGS=""
VERBOSE=false

RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

# Ensure config directory and valid YAML file exist
mkdir -p "$CONFIG_DIR"
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "targets: []" > "$CONFIG_FILE"
fi

# --- Wrappers for Distrobox ---
yq() {
    distrobox enter fedora -- yq "$@"
}

rclone() {
    distrobox enter fedora -- rclone "$@"
}

# --- Helper: Desktop Notifications ---
send_notification() {
    local title="$1"
    local message="$2"
    local urgency="${3:-normal}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="gdrive" --urgency="$urgency" --icon=google-drive "$title" "$message"
    fi
}

# In non-verbose mode, stores error lines from the last rclone run
LAST_SYNC_ERRORS=""

# --- Helper: Perform Sync ---
do_sync() {
    local local_path="$1"
    local remote_subpath="$2"
    local extra_flags="$3"

    local remote_full_path="${REMOTE}${remote_subpath}"
    local verbose_flag=""
    [[ "$VERBOSE" == true ]] && verbose_flag="--verbose"
    local all_flags="$BISYNC_FLAGS $SESSION_FLAGS $extra_flags $verbose_flag"

    LAST_SYNC_ERRORS=""

    if [[ -d "$local_path" ]]; then
        if [[ "$VERBOSE" == true ]]; then
            echo "Action: Syncing Directory [$local_path] <-> [$remote_full_path]"
            rclone bisync "$remote_full_path" "$local_path" $all_flags
        else
            local output exit_code
            output=$(rclone bisync "$remote_full_path" "$local_path" $all_flags 2>&1)
            exit_code=$?
            LAST_SYNC_ERRORS=$(printf '%s\n' "$output" | grep -E " (ERROR|FATAL) ")
            return $exit_code
        fi
    elif [[ -f "$local_path" ]]; then
        local parent_dir=$(dirname "$local_path")
        local filename=$(basename "$local_path")
        local remote_parent=$(dirname "$remote_subpath")
        [[ "$remote_parent" == "." ]] && remote_parent=""
        local remote_full_parent="${REMOTE}${remote_parent}"

        if [[ "$VERBOSE" == true ]]; then
            echo "Action: Syncing File [$local_path] <-> [${REMOTE}${remote_subpath}]"
            rclone bisync "$remote_full_parent" "$parent_dir" --include "/$filename" $all_flags
        else
            local output exit_code
            output=$(rclone bisync "$remote_full_parent" "$parent_dir" --include "/$filename" $all_flags 2>&1)
            exit_code=$?
            LAST_SYNC_ERRORS=$(printf '%s\n' "$output" | grep -E " (ERROR|FATAL) ")
            return $exit_code
        fi
    else
        echo "Error: Local path '$local_path' not found."
        return 1
    fi
}

# --- Helper: Print captured errors from last do_sync (non-verbose mode) ---
print_errors() {
    if [[ -n "$LAST_SYNC_ERRORS" ]]; then
        while IFS= read -r line; do
            printf "    ${RED}%s${NC}\n" "$line"
        done <<< "$LAST_SYNC_ERRORS"
    fi
}

# --- Command Functions ---

add_path() {
    if [[ -z "$1" ]]; then
        echo "Usage: gdrive add <local_path> [remote_path]"
        exit 1
    fi

    local local_path=$(realpath "$1")
    local remote_path="${2:-$(basename "$local_path")}"

    [[ ! -e "$local_path" ]] && echo "Error: Local path does not exist." && exit 1

    yq -i ".targets += [{\"local\": \"$local_path\", \"remote\": \"$remote_path\"}]" "$CONFIG_FILE"
    yq -i ".targets |= unique_by(.local)" "$CONFIG_FILE"

    echo "Success: Added mapping:"
    echo "  Local:  $local_path"
    echo "  Remote: $REMOTE$remote_path"
}

forget_path() {
    local local_path="$1"

    # Interactive Mode
    if [[ -z "$local_path" ]]; then
        local count=$(yq '.targets | length' "$CONFIG_FILE")
        if [[ "$count" -eq 0 ]]; then
            echo "No paths in config."
            return
        fi

        echo "Select a path to remove:"
        for ((i=0; i<$count; i++)); do
            local lp=$(yq ".targets[$i].local" "$CONFIG_FILE")
            echo "  $((i+1))) $lp"
        done

        read -p "Enter number (or 'q' to cancel): " choice
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; then
            local index=$((choice-1))
            local_path=$(yq ".targets[$index].local" "$CONFIG_FILE")
        else
            echo "Cancelled."
            return
        fi
    else
        local_path=$(realpath "$local_path")
    fi

    if yq -e ".targets[] | select(.local == \"$local_path\")" "$CONFIG_FILE" >/dev/null 2>&1; then
        yq -i ".targets |= del(.[] | select(.local == \"$local_path\"))" "$CONFIG_FILE"
        echo "Success: Removed '$local_path' from sync config."
    else
        echo "Error: No mapping found for local path '$local_path'."
    fi
}

sync_all() {
    local flag="$1"
    local count=$(yq '.targets | length' "$CONFIG_FILE")
    local failed=0
    local failed_paths=()

    if [[ "$count" -eq 0 ]]; then
        echo "No paths in config. Use 'gdrive add' first."
        exit 0
    fi

    echo "Starting Google Drive Sync ($count targets)..."

    for ((i=0; i<$count; i++)); do
        local lp=$(yq ".targets[$i].local" "$CONFIG_FILE")
        local rp=$(yq ".targets[$i].remote" "$CONFIG_FILE")

        if [[ "$VERBOSE" == true ]]; then
            if ! do_sync "$lp" "$rp" "$flag"; then
                printf 'Tip: Use gdrive resync %q if this is the first run.\n' "$lp"
                failed_paths+=("$lp")
                ((failed++))
            fi
            echo "---"
        else
            printf "  [%d/%d] %s ... " "$((i+1))" "$count" "$lp"
            if do_sync "$lp" "$rp" "$flag"; then
                printf "OK\n"
            else
                printf "${RED}FAILED${NC}\n"
                print_errors
                printf '    Tip: Use gdrive resync %q if this is the first run.\n' "$lp"
                failed_paths+=("$lp")
                ((failed++))
            fi
        fi
    done

    if [[ "$VERBOSE" != true ]]; then
        echo ""
        if [[ $failed -eq 0 ]]; then
            printf "${BOLD}Done.${NC} All $count target(s) synced successfully.\n"
        else
            printf "${BOLD}Done.${NC} ${RED}$failed/$count target(s) failed.${NC}\n"
        fi
    fi

    if [[ $failed -gt 0 ]]; then
        local body
        if [[ $failed -eq 1 ]]; then
            body="Failed to sync: ${failed_paths[0]}"
        else
            body="$failed of $count targets failed:"$'\n'
            for p in "${failed_paths[@]}"; do
                body+="• $p"$'\n'
            done
            body="${body%$'\n'}"
        fi
        send_notification "Google Drive Sync Failed" "$body" "critical"
        return 1
    fi
}

resync_path() {
    local target="$1"
    if [[ -z "$target" ]]; then
        if [[ "$VERBOSE" == true ]]; then
            echo "Performing INITIAL resync for ALL paths..."
        else
            echo "Starting initial resync for all targets..."
        fi
        sync_all "--resync"
    else
        local local_path=$(realpath "$target")
        local remote_path=$(yq ".targets[] | select(.local == \"$local_path\") | .remote" "$CONFIG_FILE")

        if [[ -z "$remote_path" || "$remote_path" == "null" ]]; then
            echo "Error: '$local_path' is not in config. Use 'gdrive add' first."
            exit 1
        fi

        if [[ "$VERBOSE" == true ]]; then
            echo "Performing INITIAL resync for [$local_path]..."
            if ! do_sync "$local_path" "$remote_path" "--resync"; then
                send_notification "Google Drive Resync Failed" "$local_path" "critical"
            fi
        else
            printf "Resyncing %s ... " "$local_path"
            if do_sync "$local_path" "$remote_path" "--resync"; then
                printf "OK\n"
            else
                printf "${RED}FAILED${NC}\n"
                print_errors
                send_notification "Google Drive Resync Failed" "$local_path" "critical"
            fi
        fi
    fi
}

# --- Main Logic ---

COMMAND=""
CMD_ARGS=()

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -d|--dry-run)
            SESSION_FLAGS="${SESSION_FLAGS:+$SESSION_FLAGS }--dry-run"
            shift
            ;;
        --prefer-local)
            SESSION_FLAGS="${SESSION_FLAGS:+$SESSION_FLAGS }--conflict-resolve prefer-path2"
            shift
            ;;
        --prefer-remote)
            SESSION_FLAGS="${SESSION_FLAGS:+$SESSION_FLAGS }--conflict-resolve prefer-path1"
            shift
            ;;
        *)
            if [[ -z "$COMMAND" ]]; then
                COMMAND="$1"
            else
                CMD_ARGS+=("$1")
            fi
            shift
            ;;
    esac
done

case "$COMMAND" in
    add)     add_path "${CMD_ARGS[0]}" "${CMD_ARGS[1]}" ;;
    forget)  forget_path "${CMD_ARGS[0]}" ;;
    sync)    sync_all "" ;;
    resync)  resync_path "${CMD_ARGS[0]}" ;;
    list)    yq '.' "$CONFIG_FILE" ;;
    *)
        echo "gdrive CLI — easily sync files to Google Drive."
        echo "Usage: gdrive [flags] <command> [args]"
        echo ""
        echo "Flags:"
        echo "  -v, --verbose        : Show full rclone output"
        echo "  -d, --dry-run        : See what would happen without making changes"
        echo "  --prefer-local       : Resolve conflicts by keeping local version"
        echo "  --prefer-remote      : Resolve conflicts by keeping remote version"
        echo ""
        echo "Commands:"
        echo "  add <local> [remote] : Add path to config"
        echo "  forget [local]       : Remove path from config (interactive if empty)"
        echo "  sync                 : Sync all configured paths"
        echo "  resync [local]       : Force resync (defaults to all paths)"
        echo "  list                 : List configured paths"
        exit 1
        ;;
esac
