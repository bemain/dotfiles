# Git
alias g='git'
alias ga='git add'
alias gc='git commit --verbose'
alias gp='git push'
alias gst='git status'

# Overwrite some git commands
git() {
  local cmd=$1; shift
  if command -v "git_$cmd" >/dev/null 2>/dev/null; then
    "git_$cmd" "$@"
  else
    command git "$cmd" "$@"
  fi
}

