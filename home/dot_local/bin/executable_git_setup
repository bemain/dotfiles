#!/usr/bin/env bash

# Locally override name/email/SSH key for this repo, overriding the global defaults.
# Run with --reset to remove the override and fall back to global defaults again.

if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo "Error: You are not inside a Git repository." >&2
    exit 1
fi

if [ "$1" == "--reset" ]; then
    git config --local --unset user.name 2>/dev/null
    git config --local --unset user.email 2>/dev/null
    git config --local --unset core.sshCommand 2>/dev/null
    git config --local --unset user.signingkey 2>/dev/null
    echo "Reset to global defaults: $(git config user.name) <$(git config user.email)>"
    exit 0
fi

echo "--- Repository Configuration ---"

CURRENT_NAME=$(git config user.name)
CURRENT_EMAIL=$(git config user.email)

read -p "Name [$CURRENT_NAME]: " GIT_NAME
read -p "Email [$CURRENT_EMAIL]: " GIT_EMAIL

git config --local user.name "${GIT_NAME:-$CURRENT_NAME}"
git config --local user.email "${GIT_EMAIL:-$CURRENT_EMAIL}"

echo -e "\nFetching keys from Bitwarden agent..."
mapfile -t keys < <(ssh-add -L)

if [ ${#keys[@]} -eq 0 ]; then
    echo "No keys found in Bitwarden agent. Is your vault unlocked?" >&2
    exit 1
fi

echo "Select the SSH key for this repo:"
select key in "${keys[@]}"; do
    if [ -n "$key" ]; then
        # Store the public key reference inside the .git folder
        # This makes the repo "portable" across your local machine
        PUBKEY_PATH="$(git rev-parse --show-toplevel)/.git/id_bw.pub"
        echo "$key" > "$PUBKEY_PATH"

        git config --local core.sshCommand "ssh -i $PUBKEY_PATH -o IdentitiesOnly=yes"
        git config --local user.signingkey "$PUBKEY_PATH"

        echo -e "\nDone! Configured as:"
        echo "  User: $(git config user.name) <$(git config user.email)>"
        echo "  Key: ${key:0:30}..."
        break
    else
        echo "Invalid selection." >&2
    fi
done
