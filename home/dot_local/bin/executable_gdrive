#!/usr/bin/env bash

## If you change this script, don't forget to update completions in
## ~/.zsh/completions/_gdrive (chezmoi: dot_zsh/completions/_gdrive)

# --- Configuration ---
CONFIG_DIR="$HOME/.config/gdrive-sync"
CONFIG_FILE="$CONFIG_DIR/config.yml"
REMOTE="gdrive:"

# Rclone comparison flags for reliability
BISYNC_FLAGS="--create-empty-src-dirs --compare size,modtime --modify-window 1s --drive-skip-gdocs --resilient --recover --max-lock 2m --filters-file $CONFIG_DIR/filters.txt"

# Global flags for the current session
SESSION_FLAGS=""
VERBOSE=false

RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

# Ensure config directory and valid YAML file exist
mkdir -p "$CONFIG_DIR"
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "targets: []" > "$CONFIG_FILE"
fi

# --- Helper: Desktop Notifications ---
send_notification() {
    local title="$1"
    local message="$2"
    local urgency="${3:-normal}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="gdrive" --urgency="$urgency" --icon=google-drive "$title" "$message"
    fi
}

# In non-verbose mode, stores error lines from the last rclone run
LAST_SYNC_ERRORS=""

# --- Helper: Perform Sync ---
# A file target is synced as its parent directory filtered down to that one file.
do_sync() {
    local local_path="$1"
    local remote_subpath="$2"
    local extra_flags="$3"

    local verbose_flag=""
    [[ "$VERBOSE" == true ]] && verbose_flag="--verbose"
    local all_flags="$BISYNC_FLAGS $SESSION_FLAGS $extra_flags $verbose_flag"

    LAST_SYNC_ERRORS=""

    local kind src dst
    local filter=()
    if [[ -d "$local_path" ]]; then
        kind="Directory"
        src="${REMOTE}${remote_subpath}"
        dst="$local_path"
    elif [[ -f "$local_path" ]]; then
        local remote_parent=$(dirname "$remote_subpath")
        [[ "$remote_parent" == "." ]] && remote_parent=""
        kind="File"
        src="${REMOTE}${remote_parent}"
        dst=$(dirname "$local_path")
        filter=(--include "/$(basename "$local_path")")
    else
        LAST_SYNC_ERRORS="Error: Local path '$local_path' not found."
        [[ "$VERBOSE" == true ]] && echo "$LAST_SYNC_ERRORS"
        return 1
    fi

    if [[ "$VERBOSE" == true ]]; then
        echo "Action: Syncing $kind [$local_path] <-> [${REMOTE}${remote_subpath}]"
        rclone bisync "$src" "$dst" "${filter[@]}" $all_flags
        return
    fi

    local output exit_code
    output=$(rclone bisync "$src" "$dst" "${filter[@]}" $all_flags 2>&1)
    exit_code=$?
    LAST_SYNC_ERRORS=$(printf '%s\n' "$output" | grep -E " (ERROR|FATAL) ")
    if [[ $exit_code -ne 0 && -z "$LAST_SYNC_ERRORS" ]]; then
        LAST_SYNC_ERRORS=$(printf '%s\n' "$output" | tail -n 3)
    fi
    return $exit_code
}

# --- Helper: Print captured errors from last do_sync (non-verbose mode) ---
print_errors() {
    if [[ -n "$LAST_SYNC_ERRORS" ]]; then
        while IFS= read -r line; do
            printf "    ${RED}%s${NC}\n" "$line"
        done <<< "$LAST_SYNC_ERRORS"
    fi
}

# --- Command Functions ---

add_path() {
    if [[ -z "$1" ]]; then
        echo "Usage: gdrive add <local_path> [remote_path]"
        exit 1
    fi

    local local_path=$(realpath "$1")
    local remote_path="${2:-$(basename "$local_path")}"

    [[ ! -e "$local_path" ]] && echo "Error: Local path does not exist." && exit 1

    yq -i ".targets += [{\"local\": \"$local_path\", \"remote\": \"$remote_path\"}]" "$CONFIG_FILE"
    yq -i ".targets |= unique_by(.local)" "$CONFIG_FILE"

    echo "Success: Added mapping:"
    echo "  Local:  $local_path"
    echo "  Remote: $REMOTE$remote_path"
}

forget_path() {
    local local_path="$1"

    # Interactive Mode
    if [[ -z "$local_path" ]]; then
        local count=$(yq '.targets | length' "$CONFIG_FILE")
        if [[ "$count" -eq 0 ]]; then
            echo "No paths in config."
            return
        fi

        echo "Select a path to remove:"
        for ((i=0; i<$count; i++)); do
            local lp=$(yq ".targets[$i].local" "$CONFIG_FILE")
            echo "  $((i+1))) $lp"
        done

        read -p "Enter number (or 'q' to cancel): " choice
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; then
            local index=$((choice-1))
            local_path=$(yq ".targets[$index].local" "$CONFIG_FILE")
        else
            echo "Cancelled."
            return
        fi
    else
        local_path=$(realpath -m "$local_path")
    fi

    if yq -e ".targets[] | select(.local == \"$local_path\")" "$CONFIG_FILE" >/dev/null 2>&1; then
        yq -i ".targets |= del(.[] | select(.local == \"$local_path\"))" "$CONFIG_FILE"
        echo "Success: Removed '$local_path' from sync config."
    else
        echo "Error: No mapping found for local path '$local_path'."
    fi
}

failure_title() {
    if [[ "$1" == "--resync" ]]; then
        echo "Google Drive Resync Failed"
    else
        echo "Google Drive Sync Failed"
    fi
}

# Syncs one target and reports the result; label prefixes the non-verbose status line.
# Flag is "" for a normal sync or "--resync".
sync_target() {
    local local_path="$1"
    local remote_path="$2"
    local flag="$3"
    local label="$4"
    local indent=""

    if [[ "$VERBOSE" == true ]]; then
        do_sync "$local_path" "$remote_path" "$flag" && return 0
    else
        printf "%s ... " "$label"
        if do_sync "$local_path" "$remote_path" "$flag"; then
            printf "OK\n"
            return 0
        fi
        printf "${RED}FAILED${NC}\n"
        print_errors
        indent="    "
    fi

    [[ -z "$flag" && -e "$local_path" ]] && printf '%sTip: Use gdrive resync %q if this is the first run.\n' "$indent" "$local_path"
    return 1
}

sync_all() {
    local flag="$1"
    local locals=() remotes=()
    local lp rp
    while IFS=$'\t' read -r lp rp; do
        locals+=("$lp")
        remotes+=("$rp")
    done < <(yq '.targets[] | [.local, .remote] | @tsv' "$CONFIG_FILE")

    local count=${#locals[@]}
    local failed_paths=()

    if [[ "$count" -eq 0 ]]; then
        echo "No paths in config. Use 'gdrive add' first."
        exit 0
    fi

    echo "Starting Google Drive Sync ($count targets)..."

    for ((i=0; i<count; i++)); do
        lp="${locals[$i]}"
        if ! sync_target "$lp" "${remotes[$i]}" "$flag" "$(printf '  [%d/%d] %s' "$((i+1))" "$count" "$lp")"; then
            failed_paths+=("$lp")
        fi
        [[ "$VERBOSE" == true ]] && echo "---"
    done

    local failed=${#failed_paths[@]}

    if [[ "$VERBOSE" != true ]]; then
        echo ""
        if [[ $failed -eq 0 ]]; then
            printf "${BOLD}Done.${NC} All $count target(s) synced successfully.\n"
        else
            printf "${BOLD}Done.${NC} ${RED}$failed/$count target(s) failed.${NC}\n"
        fi
    fi

    if [[ $failed -gt 0 ]]; then
        local body
        if [[ $failed -eq 1 ]]; then
            body="Failed to sync: ${failed_paths[0]}"
        else
            body="$failed of $count targets failed:"$'\n'
            for p in "${failed_paths[@]}"; do
                body+="• $p"$'\n'
            done
            body="${body%$'\n'}"
        fi
        send_notification "$(failure_title "$flag")" "$body" "critical"
        return 1
    fi
}

sync_one() {
    local local_path=$(realpath -m "$1")
    local flag="$2"
    local remote_path=$(yq ".targets[] | select(.local == \"$local_path\") | .remote" "$CONFIG_FILE")

    if [[ -z "$remote_path" || "$remote_path" == "null" ]]; then
        echo "Error: '$local_path' is not in config. Use 'gdrive add' first."
        exit 1
    fi

    local progress="Syncing"
    [[ "$flag" == "--resync" ]] && progress="Resyncing"

    if ! sync_target "$local_path" "$remote_path" "$flag" "$progress $local_path"; then
        send_notification "$(failure_title "$flag")" "$local_path" "critical"
        return 1
    fi
}

resync_path() {
    local target="$1"
    if [[ -z "$target" ]]; then
        if [[ "$VERBOSE" == true ]]; then
            echo "Performing INITIAL resync for ALL paths..."
        else
            echo "Starting initial resync for all targets..."
        fi
        sync_all "--resync"
    else
        sync_one "$target" "--resync"
    fi
}

sync_cmd() {
    local target="$1"
    if [[ -z "$target" ]]; then
        sync_all ""
    else
        sync_one "$target" ""
    fi
}

# --- Main Logic ---

COMMAND=""
CMD_ARGS=()

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -d|--dry-run)
            SESSION_FLAGS="${SESSION_FLAGS:+$SESSION_FLAGS }--dry-run"
            shift
            ;;
        --prefer-local)
            SESSION_FLAGS="${SESSION_FLAGS:+$SESSION_FLAGS }--conflict-resolve path2"
            shift
            ;;
        --prefer-remote)
            SESSION_FLAGS="${SESSION_FLAGS:+$SESSION_FLAGS }--conflict-resolve path1"
            shift
            ;;
        *)
            if [[ -z "$COMMAND" ]]; then
                COMMAND="$1"
            else
                CMD_ARGS+=("$1")
            fi
            shift
            ;;
    esac
done

case "$COMMAND" in
    add)     add_path "${CMD_ARGS[0]}" "${CMD_ARGS[1]}" ;;
    forget)  forget_path "${CMD_ARGS[0]}" ;;
    sync)    sync_cmd "${CMD_ARGS[0]}" ;;
    resync)  resync_path "${CMD_ARGS[0]}" ;;
    list)    yq '.' "$CONFIG_FILE" ;;
    *)
        echo "gdrive CLI — easily sync files to Google Drive."
        echo "Usage: gdrive [flags] <command> [args]"
        echo ""
        echo "Flags:"
        echo "  -v, --verbose        : Show full rclone output"
        echo "  -d, --dry-run        : See what would happen without making changes"
        echo "  --prefer-local       : Resolve conflicts by keeping local version"
        echo "  --prefer-remote      : Resolve conflicts by keeping remote version"
        echo ""
        echo "Commands:"
        echo "  add <local> [remote] : Add path to config"
        echo "  forget [local]       : Remove path from config (interactive if empty)"
        echo "  sync [local]         : Sync one configured path (defaults to all paths)"
        echo "  resync [local]       : Force resync (defaults to all paths)"
        echo "  list                 : List configured paths"
        exit 1
        ;;
esac
