# Authenticate to GitHub over SSH through the Bitwarden agent, so no token is
# stored on disk and it works the same on the host and in distrobox.
[url "git@github.com:"]
	insteadOf = https://github.com/

[url "git@gist.github.com:"]
	insteadOf = https://gist.github.com/

[user]
	name = bemain
	email = benjamin.agardh@gmail.com
	signingkey = ~/.ssh/id_default.pub

[gpg]
	format = ssh

[init]
	defaultBranch = main

[push]
    default = current
	autoSetupRemote = true

[pull]
    rebase = true

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[color]
    ui = auto

[core]
    sshCommand = ssh -i ~/.ssh/id_default.pub -o IdentitiesOnly=yes

[alias]
	# Undo last commit but keep changes
	undo = reset HEAD~1 --soft
	# Undoes an undo by using the reflog
	redo = !git reset 'HEAD@{1}' --soft
	# Edit the last commit message
	edit = commit --amend --only
	# List aliases
	aliases = config --get-regexp alias
